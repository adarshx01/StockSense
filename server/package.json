{
  "name": "stocksense-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node --env-file=.env dist/server.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed": "tsx --env-file=.env src/db/seed.ts",
    "test": "tsx --test tests/story.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.840.0",
    "@aws-sdk/client-ses": "^3.840.0",
    "@fastify/aws-lambda": "^5.1.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^9.1.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.3.3",
    "pg": "^8.16.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
