DATABASE_URL=postgresql://stocksense:stocksense_local@localhost:5433/stocksense
JWT_SECRET=replace-with-a-long-random-string
SES_FROM_EMAIL=
SEED_EMAIL=manager@stocksense.local
SEED_PASSWORD=replace-with-a-local-password
CORS_ORIGIN=http://localhost:5173
PORT=3001
AWS_REGION=ap-south-1
NODE_ENV=development
# Gmail needs an app password, not the normal account password. OTP is sent to the account email, so use a real inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
